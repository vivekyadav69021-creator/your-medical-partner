/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model while
 * providing a secure bypass for the verified Administrator.
 *
 * Admin User: yourmedicalpartner07@gmail.com
 *
 * Key Security Decisions:
 * - Admin Bypass: The Administrator has broad read/write access to manage the 
 *   platform, audit users, and ingest content.
 * - Public Content: Medicines, Disease, Yoga, and Video libraries are publicly
 *   readable but only writable by the Admin.
 * - User Isolation: Standard users can only access their own private data under /users/{userId}.
 * - System Control: Feature flags in system_settings are readable by all for
 *   maintenance guarding but strictly writable by Admin.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user is the platform Administrator.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'yourmedicalpartner07@gmail.com';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Public Content Collections (Read for all, Write for Admin)
    // -------------------------------------------------------------------------

    match /video_tutorials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /disease_library/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /yoga_library/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /medicines/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /doctors/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // System and Feedback
    // -------------------------------------------------------------------------

    match /system_settings/{id} {
      // All users need to read feature flags for MaintenanceGuard functionality.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // User Data Collections (/users/{userId}/*)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      // Admin can list and get users for auditing purposes.
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();

      match /userProfiles/{userProfileId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && userId == userProfileId;
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /appointments/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /medicalOrders/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // -------------------------------------------------------------------------
    // Authentication Data
    // -------------------------------------------------------------------------

    match /auth/{userId} {
      allow create: if isOwner(userId);
      allow get, list, delete: if isAdmin();
      allow read, update: if false;
    }
  }
}